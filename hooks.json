{
  "alexein-memory": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./scripts/alexein_hooks.py run antigravity session-start",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./scripts/alexein_hooks.py run antigravity prompt",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/alexein_hooks.py run antigravity tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/alexein_hooks.py run antigravity stop",
        "timeout": 10
      }
    ]
  }
}
